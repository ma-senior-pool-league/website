---
/**
 * Plain-language report for the commissioner: when the site last read the
 * league Google Sheet, and any rows it had to skip. Not linked from the menu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLeague, isPlayed, readSyncStatus } from '../lib/league';
import { formatDate } from '../lib/format';
import { site } from '../site.config';

const { problems, pendingApproval, currentSeason, teamById, divisionById } = getLeague();

// Played matches whose score sheet hasn't been read into the Games tab yet.
const waiting = currentSeason.matches.filter((m) => isPlayed(m) && m.games.length === 0);
const sync = readSyncStatus();

/** CSV file name -> the tab name people see in the Google Sheet. */
const tabName = (file: string) =>
  file.replace(/\.csv$/, '').replace(/^\w/, (c) => c.toUpperCase());

const byTab = new Map<string, typeof problems>();
for (const p of problems) byTab.set(tabName(p.file), [...(byTab.get(tabName(p.file)) ?? []), p]);

const builtAt = new Date().toLocaleString('en-US', { timeZone: site.timezone, dateStyle: 'full', timeStyle: 'short' });
const syncedAt = sync
  ? new Date(sync.syncedAt).toLocaleString('en-US', { timeZone: site.timezone, dateStyle: 'full', timeStyle: 'short' })
  : '';
const syncFailures = sync ? Object.entries(sync.files).filter(([, s]) => s.startsWith('error')) : [];
---

<BaseLayout title="Data check" description="Status of the league data behind this website.">
  <meta name="robots" content="noindex" slot="head" />
  <h1>Data check</h1>
  <p class="lede">
    This page shows whether the website could read everything in the league Google Sheet. Bookmark it.
  </p>

  <ul class="card-list card">
    <li><strong>Website last updated:</strong> {builtAt}</li>
    <li>
      <strong>Google Sheet last read:</strong>
      {syncedAt || 'Not connected to the Google Sheet yet (using the copy saved with the website).'}
    </li>
    {
      pendingApproval > 0 && (
        <li>
          <strong>Waiting for approval:</strong> {pendingApproval} result{pendingApproval === 1 ? '' : 's'} on the
          Results tab {pendingApproval === 1 ? 'is' : 'are'} not ticked "Approved" yet.
        </li>
      )
    }
  </ul>

  {
    syncFailures.length > 0 && (
      <section aria-labelledby="sync-heading">
        <h2 id="sync-heading">Tabs that couldn't be read</h2>
        <p>The website kept using the last good copy of these tabs:</p>
        <ul class="card-list card">
          {syncFailures.map(([file, status]) => (
            <li>
              <strong>{tabName(file.split('/').pop()!)}:</strong> {status.replace(/^error:\s*/, '')}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2>Score sheets waiting to be read</h2>
  {
    waiting.length ? (
      <>
        <p>
          {waiting.length} {currentSeason.name} match{waiting.length === 1 ? ' has' : 'es have'} a result but no
          game-by-game rows yet, so player stats don't include them. Whoever reads score sheets (or their AI agent)
          can work from this list; see the <a href="/score-sheet-agent/">score-sheet agent instructions</a>.
        </p>
        <div class="table-wrap">
          <table>
            <caption>Waiting to be read</caption>
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Division</th>
                <th scope="col">Match</th>
                <th scope="col">Score sheet</th>
              </tr>
            </thead>
            <tbody>
              {waiting.map((m) => (
                <tr>
                  <td>{formatDate(m.date)}</td>
                  <td>{divisionById.get(m.divisionId)?.name}</td>
                  <td class="wrap">
                    Week {m.week}: {teamById.get(m.awayId)!.name} at {teamById.get(m.homeId)!.name},{' '}
                    {m.awayScore}–{m.homeScore}
                  </td>
                  <td>
                    {m.scoreSheetUrls.length
                      ? m.scoreSheetUrls.map((url, i) => (
                          <a href={url} rel="noopener noreferrer" target="_blank">
                            Photo{m.scoreSheetUrls.length > 1 ? ` ${i + 1}` : ''}{' '}
                          </a>
                        ))
                      : 'No photo sent'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ) : (
      <p class="card">Every {currentSeason.name} match with a result has been read.</p>
    )
  }

  <h2>Rows the website skipped</h2>
  {
    problems.length ? (
      <>
        <p>
          Fix these in the Google Sheet. The website will pick up the change the next time it updates. Row numbers
          match the row numbers in the Sheet.
        </p>
        {[...byTab.entries()].map(([tab, list]) => (
          <section aria-label={`${tab} tab`}>
            <h3>{tab} tab</h3>
            {tab === 'Results' && (
              <p class="meta">
                The Results tab copies the Form Responses 1 tab. Make corrections on Form Responses 1.
              </p>
            )}
            <ul class="card-list card">
              {list.map((p) => (
                <li>
                  {p.row && <strong>Row {p.row}: </strong>}
                  {p.message}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    ) : (
      <p class="card" style="font-weight: 700; color: var(--win);">
        ✓ Everything in the Google Sheet was read without problems.
      </p>
    )
  }
</BaseLayout>
