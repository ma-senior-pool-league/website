---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MatchTable from '../../components/MatchTable.astro';
import { getLeague, playerName } from '../../lib/league';

export const getStaticPaths = (() =>
  getLeague().teams.map((team) => ({ params: { id: team.id } }))) satisfies GetStaticPaths;

const league = getLeague();
const team = league.teamById.get(Astro.params.id!)!;
const division = league.divisionById.get(team.divisionId)!;
const venue = league.locationById.get(team.locationId);

// Roster with this season's individual records (players who played without being on the roster are included).
const season = league.currentSeason;
const statRows = (season.playerStats.get(team.divisionId) ?? []).filter((r) => r.player.teamId === team.id);
const rosterPlayers = league.players.filter((p) => p.teamId === team.id && !p.provisional);
const roster = [
  ...rosterPlayers.map((p) => ({ player: p, stats: statRows.find((r) => r.player.id === p.id) })),
  ...statRows.filter((r) => r.player.provisional).map((r) => ({ player: r.player, stats: r })),
].sort((a, b) => (b.stats?.games ?? 0) - (a.stats?.games ?? 0) || a.player.name.localeCompare(b.player.name));

// Every season this team has a schedule in, newest first.
const history = league.seasons
  .map((season) => {
    const matches = season.matches.filter((m) => m.homeId === team.id || m.awayId === team.id);
    if (!matches.length) return undefined;
    const divisionId = matches[0]!.divisionId;
    const standing = season.standings.get(divisionId)!;
    const rank = standing.findIndex((r) => r.team.id === team.id) + 1;
    return { season, matches, divisionId, rank, row: standing[rank - 1]!, teamsInDivision: standing.length };
  })
  .filter((h) => h !== undefined);
---

<BaseLayout title={team.name} description={`${team.name}: ${division.name} division team page.`}>
  <p><a href="/teams/">&larr; All teams</a></p>
  <h1>{team.name}</h1>
  <p class="lede">{division.name} division</p>

  {
    venue && (
      <div class="card" style="margin-bottom: 1.5rem;">
        <strong>Home location</strong>
        <div>
          {venue.name}, {venue.address}, {venue.city}
          {venue.phone && <> · <a href={`tel:${venue.phone.replace(/[^\d+]/g, '')}`}>{venue.phone}</a></>}
        </div>
        {team.note && <p class="meta" style="margin: 0.25rem 0 0;">{team.note}</p>}
        <a class="more" href={`/locations/#${venue.id}`}>Map &amp; all locations &rarr;</a>
      </div>
    )
  }

  {
    roster.length > 0 && (
      <section aria-labelledby="roster-heading">
        <h2 id="roster-heading">Players</h2>
        <div class="table-wrap">
          <table>
            <caption>{team.name} players, {season.name} record</caption>
            <thead>
              <tr>
                <th scope="col">Player</th>
                <th scope="col" class="num">W</th>
                <th scope="col" class="num">L</th>
                <th scope="col" class="num">Win %</th>
                <th scope="col" class="num">Games</th>
              </tr>
            </thead>
            <tbody>
              {roster.map(({ player, stats }) => (
                <tr>
                  <th scope="row">{playerName(player, league.settings)}</th>
                  <td class="num">{stats ? stats.wins : ''}</td>
                  <td class="num">{stats ? stats.losses : ''}</td>
                  <td class="num">{stats ? `${(stats.winPct * 100).toFixed(1)}%` : ''}</td>
                  <td class="num">{stats ? stats.games : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {statRows.length > 0 && (
          <a class="more" href={`/seasons/${season.id}/${team.divisionId}/players/`}>
            All {league.divisionById.get(team.divisionId)!.name} player stats &rarr;
          </a>
        )}
      </section>
    )
  }

  {
    history.length ? (
      history.map(({ season, matches, divisionId, rank, row, teamsInDivision }) => (
        <section aria-labelledby={`season-${season.id}`}>
          <h2 id={`season-${season.id}`}>{season.name}</h2>
          <p>
            {season.status === 'final' ? 'Finished' : 'Currently'} #{rank} of {teamsInDivision} ·{' '}
            <strong>
              {row.wins}–{row.losses}
            </strong>{' '}
            in matches · {row.gamesWon} games won ·{' '}
            <a href={`/seasons/${season.id}/${divisionId}/`}>Division results</a>
          </p>
          <MatchTable matches={matches} showWeek showScoreSheets />
        </section>
      ))
    ) : (
      <p class="empty">No schedule posted for this team yet.</p>
    )
  }
</BaseLayout>
